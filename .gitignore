# Secrets
.env
.env.*
!.env.example
secrets/

# Local toolchains and virtualenvs
.toolchains/
.venv/

# Disposable development workspaces: credentials, databases, queue data, devnet keys.
.local/
venv/

# Typecheck and test caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Key files
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Chain key files
priv_validator_key.json
node_key.json
priv_validator_state.json
keyring-*/

# Mnemonic and seed files (.txt and .json only)
*mnemonic*.txt
*mnemonic*.json
seed.txt
seed.json
seeds.txt
seeds.json
*.seed
*seed-phrase*.txt
*seed-phrase*.json
*seed_phrase*.txt
*seed_phrase*.json

# Media uploads and video bytes
/uploads/
**/media-uploads/
**/user-uploads/
*.mp4
*.m4v
*.mov
*.mkv
*.webm
*.avi
*.mpeg
*.mpg

# Database dumps
*.dump
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db

# Build output. build, bin, and dist are anchored to the repo root
# so internal/build and cmd/.../bin stay trackable.
node_modules/
/dist/
/build/
/bin/
coverage/
*.log
.cache/
__pycache__/
