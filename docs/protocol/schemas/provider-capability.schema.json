{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "svn-provider-capability-v1",
  "title": "SVN provider capability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "provider_id", "signing_key_id", "declared_capacity_bytes", "endpoints"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "SVN-JCS-1"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "signing_key_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "declared_capacity_bytes": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 64},
          "url": {"type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^https://"}
        }
      }
    }
  }
}
